# Archivos que no se comparten ni se suben a git

# Entornos virtuales
.venv/
venv/
env/

# Caché de Python (bytecode)
__pycache__/
*.py[cod]

# Metadatos de instalación (se regeneran con pip install -e .)
*.egg-info/

# Caché de pruebas
.pytest_cache/
.coverage

# PyInstaller
build/
dist/

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Archivos comprimidos
*.zip
*.tar.gz

# Basura de editores
.idea/
.vscode/
*.swp

# Estado interno de skills/herramientas de agente (desarrollo, no producto)
.impeccable/
.superpowers/
.opencode/

# Dependencias y artefactos de la suite web E2E
tests_web/node_modules/
tests_web/artefactos/

# Proyecto Astro (la versión desplegada en Pages)
web-astro/node_modules/
web-astro/dist/
web-astro/.astro/

# Logs
*.log